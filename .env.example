# =====================================================
# SIAC — Backend
# Copia este archivo como .env y rellena los valores.
# NUNCA subas el .env real al repositorio.
# =====================================================

# Cadena de conexión de PostgreSQL (Neon)
DATABASE_URL=

# Secreto para firmar los JWT. Usa una cadena larga y aleatoria.
# Generar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Puerto del servidor
PORT=4000

# development | production
NODE_ENV=development

# Orígenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:3000


# Archivo histórico (app biblioteca-siac)
# URL del deploy de la biblioteca, sin diagonal final
ARCHIVO_URL=
# Llave servidor a servidor (≥24 caracteres). La MISMA en la biblioteca.
SIAC_API_KEY=
# Secreto del SSO (≥32 caracteres). El MISMO en la biblioteca.
SSO_SIAC_SECRET=
