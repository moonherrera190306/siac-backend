generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* =========================================
   👤 USUARIOS
========================================= */

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role

  activo    Boolean  @default(true)

  debeCambiarPassword Boolean @default(true)

  createdAt DateTime @default(now())

  alumno    Alumno?
  docente   Docente?
}

/* =========================================
   👨‍🎓 ALUMNOS
========================================= */

model Alumno {
  id             String           @id @default(uuid())
  matricula      String           @unique
  userId         String           @unique

  grupoId        String?

  createdAt      DateTime         @default(now())

  user           User             @relation(fields: [userId], references: [id])
  grupo          Grupo?           @relation(fields: [grupoId], references: [id])

  calificaciones Calificacion[]
  pagos          Pago[]
  asistencias    Asistencia[]
  documentos     Documento[]
}

/* =========================================
   👨‍🏫 DOCENTES
========================================= */

model Docente {
  id        String      @id @default(uuid())
  userId    String      @unique

  user      User        @relation(fields: [userId], references: [id])

  materias  Materia[]
}

/* =========================================
   📚 PROGRAMAS
========================================= */

model Programa {
  id         String      @id @default(uuid())
  nombre     String

  carreras   Carrera[]
}

/* =========================================
   🏫 CARRERAS
========================================= */

model Carrera {
  id          String      @id @default(uuid())
  nombre      String

  programaId  String

  programa    Programa    @relation(fields: [programaId], references: [id])

  semestres   Semestre[]
}

/* =========================================
   📖 SEMESTRES
========================================= */

model Semestre {
  id          String      @id @default(uuid())
  nombre      String

  carreraId   String

  carrera     Carrera     @relation(fields: [carreraId], references: [id])

  grupos      Grupo[]
}

/* =========================================
   👥 GRUPOS
========================================= */

model Grupo {
  id            String         @id @default(uuid())
  nombre        String

  semestreId    String

  semestre      Semestre       @relation(fields: [semestreId], references: [id])

  alumnos       Alumno[]
  materias      Materia[]
  asistencias   Asistencia[]
}

/* =========================================
   📘 MATERIAS
========================================= */

model Materia {
  id               String            @id @default(uuid())
  nombre           String

  grupoId          String
  docenteId        String?

  grupo            Grupo             @relation(fields: [grupoId], references: [id])
  docente          Docente?          @relation(fields: [docenteId], references: [id])

  calificaciones   Calificacion[]
}

/* =========================================
   📝 CALIFICACIONES
========================================= */

model Calificacion {
  id             String       @id @default(uuid())

  alumnoId       String
  materiaId      String

  calificacion   Float

  createdAt      DateTime     @default(now())

  alumno         Alumno       @relation(fields: [alumnoId], references: [id])
  materia        Materia      @relation(fields: [materiaId], references: [id])

  // 🔥 evita duplicados alumno + materia
  @@unique([alumnoId, materiaId])
}

/* =========================================
   📅 ASISTENCIAS
========================================= */

model Asistencia {
  id          String               @id @default(uuid())

  fecha       DateTime             @default(now())
  estado      EstadoAsistencia

  alumnoId    String
  grupoId     String?

  createdAt   DateTime             @default(now())

  alumno      Alumno               @relation(fields: [alumnoId], references: [id])
  grupo       Grupo?               @relation(fields: [grupoId], references: [id])

  // 🔥 evita asistencia duplicada mismo día
  @@unique([alumnoId, fecha])
}

/* =========================================
   📄 DOCUMENTOS
========================================= */

model Documento {
  id          String        @id @default(uuid())

  nombre      String
  tipo        String
  url         String

  alumnoId    String

  createdAt   DateTime      @default(now())

  alumno      Alumno        @relation(fields: [alumnoId], references: [id])
}

/* =========================================
   💰 CUOTAS
========================================= */

model Cuota {
  id          String      @id @default(uuid())

  nombre      String
  monto       Float

  createdAt   DateTime    @default(now())

  pagos       Pago[]
}

/* =========================================
   💳 PAGOS
========================================= */

model Pago {
  id          String      @id @default(uuid())

  alumnoId    String
  cuotaId     String?

  concepto    String
  monto       Float

  pagadoEn    DateTime    @default(now())

  alumno      Alumno      @relation(fields: [alumnoId], references: [id])
  cuota       Cuota?      @relation(fields: [cuotaId], references: [id])
}

/* =========================================
   🎭 ROLES
========================================= */

enum Role {
  ADMIN
  ALUMNO
  CAJA
  DIRECTOR
  MAESTRO
  SECRETARIA
}

/* =========================================
   📌 ESTADOS ASISTENCIA
========================================= */

enum EstadoAsistencia {
  PRESENTE
  FALTA
  RETARDO
}