generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * =========================================
 * 👤 USUARIOS
 * =========================================
 */

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String
  role     Role

  activo Boolean @default(true)

  debeCambiarPassword Boolean @default(true)

  createdAt DateTime @default(now())

  alumno  Alumno?
  docente Docente?
}

/**
 * =========================================
 * 👨‍🎓 ALUMNOS
 * =========================================
 */

model Alumno {
  id String @id @default(uuid())

  matricula String @unique

  telefono  String?
  direccion String?
  curp      String?

  fechaNacimiento DateTime?

  foto String?

  activo Boolean @default(true)

  //////////////////////////////////////////////////
  // 🔥 USER
  //////////////////////////////////////////////////

  userId String @unique

  user User @relation(fields: [userId], references: [id])

  //////////////////////////////////////////////////
  // 🔥 RELACIONES ACADÉMICAS
  //////////////////////////////////////////////////

  grupoId String?

  grupo Grupo? @relation(fields: [grupoId], references: [id])

  programaId String?

  programa Programa? @relation(fields: [programaId], references: [id])

  carreraId String?

  carrera Carrera? @relation(fields: [carreraId], references: [id])

  //////////////////////////////////////////////////
  // 🔥 PERFIL
  //////////////////////////////////////////////////

  sexo String?

  ciudad       String?
  estado       String?
  codigoPostal String?

  tutorNombre   String?
  tutorTelefono String?

  estatusAcademico String? @default("ACTIVO")

  //////////////////////////////////////////////////
  // 🔥 RELACIONES IMPORTANTES
  //////////////////////////////////////////////////

  pagos Pago[]

  documentos Documento[]

  asistencias Asistencia[]

  calificaciones Calificacion[]

  //////////////////////////////////////////////////
  // 🔥 FECHAS
  //////////////////////////////////////////////////

  createdAt DateTime @default(now())
}

/**
 * =========================================
 * 👨‍🏫 DOCENTES
 * =========================================
 */

model Docente {
  id     String @id @default(uuid())
  userId String @unique

  user User @relation(fields: [userId], references: [id])
  asignaciones AsignacionMateria[]
}

/**
 * =========================================
 * 📚 PROGRAMAS
 * =========================================
 */

model Programa {
  id String @id @default(uuid())

  nombre String @unique

  carreras Carrera[]

  alumnos Alumno[]
}

/**
 * =========================================
 * 🏫 CARRERAS
 * =========================================
 */

model Carrera {
  id String @id @default(uuid())

  nombre String @unique

  programaId String?

  programa Programa? @relation(fields: [programaId], references: [id])

  semestres Semestre[]

  alumnos Alumno[]
}

/**
 * =========================================
 * 📖 SEMESTRES
 * =========================================
 */

model Semestre {
  id     String @id @default(uuid())
  nombre String

  carreraId String?

  carrera Carrera? @relation(fields: [carreraId], references: [id])

  grupos    Grupo[]
  createdAt DateTime @default(now())
}

/**
 * =========================================
 * 👥 GRUPOS
 * =========================================
 */

model Grupo {
  id String @id @default(uuid())

  nombre String

  turno String?
  nivel String?

  semestreId String?

  semestre Semestre? @relation(fields: [semestreId], references: [id])

  alumnos     Alumno[]
  asistencias Asistencia[]
  asignaciones AsignacionMateria[]

  createdAt DateTime @default(now())
}

/**
 * =========================================
 * 📘 MATERIAS
 * =========================================
 */

model Materia {

  id String @id @default(uuid())

  nombre String

  descripcion String?

  calificaciones Calificacion[]
  asignaciones AsignacionMateria[]
}
model AsignacionMateria {

  id String @id @default(uuid())

  materiaId String
  docenteId String
  grupoId String
  cicloEscolarId String

  horario String?
  aula String?

  createdAt DateTime @default(now())

  materia Materia @relation(fields: [materiaId], references: [id])

  docente Docente @relation(fields: [docenteId], references: [id])

  grupo Grupo @relation(fields: [grupoId], references: [id])

  cicloEscolar CicloEscolar @relation(fields: [cicloEscolarId], references: [id])
}

model CicloEscolar {

  id String @id @default(uuid())

  nombre String @unique

  activo Boolean @default(true)

  fechaInicio DateTime?
  fechaFin DateTime?

  asignaciones AsignacionMateria[]

  createdAt DateTime @default(now())
}
/**
 * =========================================
 * 📝 CALIFICACIONES
 * =========================================
 */

model Calificacion {
  id String @id @default(uuid())

  alumnoId  String
  materiaId String

  calificacion Float

  createdAt DateTime @default(now())

  alumno  Alumno  @relation(fields: [alumnoId], references: [id])
  materia Materia @relation(fields: [materiaId], references: [id])

  // 🔥 evita duplicados alumno + materia
  @@unique([alumnoId, materiaId])
}

/**
 * =========================================
 * 📅 ASISTENCIAS
 * =========================================
 */

model Asistencia {
  id String @id @default(uuid())

  fecha  DateTime         @default(now())
  estado EstadoAsistencia

  alumnoId String
  grupoId  String?

  createdAt DateTime @default(now())

  alumno Alumno @relation(fields: [alumnoId], references: [id])
  grupo  Grupo? @relation(fields: [grupoId], references: [id])

  // 🔥 evita asistencia duplicada mismo día
  @@unique([alumnoId, fecha])
}

/**
 * =========================================
 * 📄 DOCUMENTOS
 * =========================================
 */

model Documento {
  id String @id @default(uuid())

  nombre String
  tipo   String
  url    String

  estado String @default("Pendiente")

  alumnoId String

  createdAt DateTime @default(now())

  alumno Alumno @relation(fields: [alumnoId], references: [id])
}

/**
 * =========================================
 * 💰 CUOTAS
 * =========================================
 */

model Cuota {
  id String @id @default(uuid())

  nombre String
  monto  Float

  createdAt DateTime @default(now())

  pagos Pago[]
}

/**
 * =========================================
 * 💳 PAGOS
 * =========================================
 */

model Pago {
  id String @id @default(uuid())

  alumnoId String
  cuotaId  String?

  concepto String
  monto    Float

  pagadoEn DateTime?

  alumno Alumno @relation(fields: [alumnoId], references: [id])
  cuota  Cuota? @relation(fields: [cuotaId], references: [id])
}

/**
 * =========================================
 * 🎭 ROLES
 * =========================================
 */

enum Role {
  ADMIN
  ALUMNO
  CAJA
  DIRECTOR
  MAESTRO
  SECRETARIA
}

/**
 * =========================================
 * 📌 ESTADOS ASISTENCIA
 * =========================================
 */

enum EstadoAsistencia {
  PRESENTE
  FALTA
  RETARDO
}
